{
  "name": "poster-pop",
  "about": "Loud flat colour, heavy condensed caps, hard offset shadows, hard cuts. Myths, rankings, money, sport, anything argued with attitude.",
  "palette": {
    "bg": [
      "#FFD84D",
      "#FFD23F",
      "#FFC72C"
    ],
    "ink": "#15110D",
    "subject": "#C9182B",
    "accent": "#1D3557",
    "data": "#7B2CBF",
    "alert": "#7A0019",
    "good": "#1B7F5C",
    "panel": "#FFF8E1",
    "onAccent": "#FFF8E1"
  },
  "fonts": {
    "display": "Anton",
    "body": "DM Sans",
    "mono": "Space Mono"
  },
  "backdrop": {
    "type": "sunburst",
    "color": "subject",
    "strength": 1.2
  },
  "post": {
    "vignette": 0.15,
    "scrim": 0
  },
  "captions": {
    "case": "upper",
    "highlight": "box",
    "weight": 400,
    "size": 86,
    "strokeW": 0,
    "boxRadius": 6
  },
  "hud": {
    "type": "none"
  },
  "shape": {
    "radius": 6,
    "stroke": 4,
    "strokeAlpha": 1,
    "panelAlpha": 1,
    "shadow": {
      "dx": 10,
      "dy": 10,
      "color": "ink"
    }
  },
  "transition": {
    "duration": 0.5,
    "default": "cut"
  },
  "illustrations": {
    "set": "flat",
    "sticker": 0.05,
    "stickerColor": "panel",
    "shadow": {
      "dx": 0.045,
      "dy": 0.045,
      "blur": 0,
      "alpha": 1,
      "color": "ink"
    }
  }
}

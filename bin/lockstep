#!/usr/bin/env bash
# lockstep — one entry point for the whole pipeline.
# <video> is a folder under videos/ (give its name) or a path to any folder with a video.json.
set -euo pipefail
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
E="$REPO/engine"

usage() {
  cat <<'EOF'
lockstep <command> [<video>] [options]

  setup [--with-asr]            install dependencies and models (scripts/setup.sh)
  doctor                        report what is installed, change nothing
  new <slug> ["Title"]          scaffold videos/<slug>/ (blank creative brief, no style yet)
  list                          list video projects

 direction — decided before any narration or scene; voice and build refuse until it is done
  brief <video>                 check docs/creative_brief.md and style.json are complete
  style-check <video>           validity and legibility of style.json (grade, captions, fonts)
  fonts                         the bundled font families and their character
  icons <word>                  search the 2,300 bundled icons

 media — real photographs, paintings, maps, film and 3D from free, licensed sources
  sources                       the sources, what each holds, which need a free key (Pexels, Pixabay)
  find <video> <kind> "<query>" [--sources a,b] [--n 24] [--allow-sa]
                                search every source of that kind at once (photo, video, model, hdri, texture)
                                -> a numbered contact sheet out/find/<search>.jpg with source, licence, size
  take <video> <search|last> <n> [--as name]
                                download candidate n into media/<name> and record its credit and licence
  media <video> [list]          what has been taken, with licences
  media <video> restore         download every credited file again (media files are not committed)
  media <video> credits         docs/credits.md: the credit lines for the video's description
  media <video> add <file|url> --as name --licence "CC0" [--author ..] [--page url] [--title ..]
                                bring in a file obtained another way (a Kenney or Quaternius pack, your own photo)
  cutout <video> <name>         cut the subject of a photo out of its background -> media/<name>.cut.png
  look <video>                  every picture and clip through the video's grade with a line of captions
                                -> out/look.jpg (works before any narration exists)

 narration
  voice <video> [voice] [speed] record the narration from script.py -> audio/narration_24k.wav, data/words.json
                                ("voice <video> list" prints the available voices)
  check-voice <video>           transcribe the narration back and compare with the script (needs --with-asr)
  captions <video> [--draft]    check caption_phrases.json against the narration, or draft it
  words <video> [beat]          print every spoken word with its start time (for choosing cues)

 pictures
  preview <video> [--port 4173] [--host 0.0.0.0]
                                play and scrub the video in a browser, with audio; reloads itself when files change
  lint <video> [--static]       check the scenes before rendering: cues, sounds, media names and licences,
                                determinism, colours, typed-in times; where text lands (interface, captions,
                                size, contrast, overlaps). Errors stop the build. --static: the code only
  transitions [<video>] [name...] [--all] [--style f.json]
                                the scene transitions drawn in the video's look -> out/transitions.jpg: the built-in
                                ones and the recommended shader ones (--all: every one of the 223); naming some
                                shows each step by step
  meta <video>                  export data/timeline.json (scenes, captions, sound cues); also proves the scenes load
  still <video> [--safe] T...   render single frames, e.g. 3.2s 12s 450   -> out/stills/
  sheet <video> [--cols N] T... render frames and tile them into out/sheet.jpg for review
  scan <video>                  draw every 2nd frame; report script errors and near-black frames
  filmstrip <video> A:B[:n]...  rows of consecutive frames from out/frames -> out/filmstrip.jpg (motion check)

 finishing
  audio <video>                 synthesise score + sound effects and mix with the voice
  render <video> [--from s] [--to s] [--workers N]   render frames -> out/frames/
  assemble <video> [--crf 16] [--preset slow] [--remux]   master audio + encode -> dist/<output>.mp4
  srt <video>                   dist/subtitles.srt
  validate <video>              technical, sync and layout checks -> data/validation.json, dist/contact_sheet.jpg
  docs <video>                  docs/narration_script.md and docs/visual_storyboard.md
  report <video>                docs/production_report.md

  build <video>                 brief + style check -> lint -> meta -> scan -> audio -> render -> assemble -> srt -> validate
                                -> docs -> credits -> report
  selftest                      scaffold a throw-away video and run the whole pipeline on it
EOF
}

resolve() {
  local a="${1:-}"
  [ -n "$a" ] || { echo "missing <video> argument" >&2; exit 1; }
  if [ -f "$a/video.json" ]; then (cd "$a" && pwd)
  elif [ -f "$REPO/videos/$a/video.json" ]; then echo "$REPO/videos/$a"
  else echo "no video project '$a' (expected videos/$a/video.json)" >&2; exit 1; fi
}

json_field() { python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get(sys.argv[2], ""))' "$1" "$2"; }

style_gate() {   # the look must be legible before anything is rendered with it
  local out
  out=$(python3 "$E/style_check.py" "$1") || { echo "$out"; exit 1; }
  echo "$out" | grep -v -e '  PASS' -e '^$' || true
}

cmd="${1:-help}"; [ $# -gt 0 ] && shift
case "$cmd" in
  help|-h|--help) usage ;;
  setup)   exec bash "$REPO/scripts/setup.sh" "$@" ;;
  doctor)  exec bash "$REPO/scripts/setup.sh" --check ;;
  new)     exec python3 "$E/new_video.py" "$@" ;;
  list)
    for d in "$REPO"/videos/*/; do
      [ -f "$d/video.json" ] || continue
      s="(no style.json yet)"; [ -f "$d/style.json" ] && s=$(json_field "$d/style.json" name)
      m=0; [ -f "$d/media/credits.json" ] && m=$(python3 -c 'import json,sys; print(len(json.load(open(sys.argv[1]))))' "$d/media/credits.json")
      printf '  %-28s %-24s %s media\n' "$(basename "$d")" "$s" "$m"
    done ;;

  brief)        V=$(resolve "${1:-}"); python3 "$E/check_brief.py" "$V" ;;
  style-check)
    if [ "${1:-}" = "--style" ]; then python3 "$E/style_check.py" --style "${2:?style file}"
    else V=$(resolve "${1:-}"); python3 "$E/style_check.py" "$V"; fi ;;
  fonts)
    sed -n '/^| Family/,/^$/p' "$REPO/assets/fonts/README.md"
    echo "Also installed system-wide by setup: Inter, Inter Display, JetBrains Mono." ;;
  icons)
    q="${1:?give a word, e.g.: lockstep icons heart}"
    n=$(grep -ci -- "$q" "$REPO/assets/icons/names.txt" || true)
    echo "$n icons match '$q':"
    grep -i -- "$q" "$REPO/assets/icons/names.txt" | head -120 | paste -sd ' ' | fold -s -w 110 | sed 's/^/  /' ;;
  sources)      python3 "$E/media.py" sources ;;
  find)         V=$(resolve "${1:-}"); shift; python3 "$E/media.py" find "$V" "$@" ;;
  take)         V=$(resolve "${1:-}"); shift; python3 "$E/media.py" take "$V" "$@" ;;
  cutout)       V=$(resolve "${1:-}"); shift; python3 "$E/media.py" cutout "$V" "$@" ;;
  media)
    V=$(resolve "${1:-}"); shift
    sub="${1:-list}"; [ $# -gt 0 ] && shift
    case "$sub" in
      list|restore|credits) python3 "$E/media.py" "$sub" "$V" ;;
      add) python3 "$E/media.py" add "$V" "$@" ;;
      *) echo "lockstep media <video> [list|restore|credits|add <file|url> --as name --licence ...]" >&2; exit 1 ;;
    esac ;;
  look)         V=$(resolve "${1:-}"); shift; node "$E/render.js" "$V" look "$@" ;;

  voice)
    V=$(resolve "${1:-}"); shift
    if [ "${1:-}" != "list" ]; then python3 "$E/check_brief.py" "$V" >/dev/null || { python3 "$E/check_brief.py" "$V"; exit 1; }; fi
    python3 "$E/tts/synth.py" "$V" "$@" ;;
  check-voice)  V=$(resolve "${1:-}"); python3 "$E/tts/asr_check.py" "$V" 2> >(grep -v -e 'Creating a resampler' -e '_sample_rate:' -e '^[[:space:]]*$' >&2) ;;
  captions)     V=$(resolve "${1:-}"); shift; python3 "$E/make_captions.py" "$V" "$@" ;;
  words)        V=$(resolve "${1:-}"); shift; python3 "$E/words.py" "$V" "$@" ;;
  meta)         V=$(resolve "${1:-}"); node "$E/render.js" "$V" meta ;;
  lint)         V=$(resolve "${1:-}"); shift; exec python3 "$E/lint.py" "$V" "$@" ;;
  transitions)
    V="$REPO/templates/video"; OUTF=""; EXTRA=(); NAMES=()
    if [ $# -gt 0 ] && { [ -f "$1/video.json" ] || [ -f "$REPO/videos/$1/video.json" ]; }; then V=$(resolve "$1"); shift; fi
    while [ $# -gt 0 ]; do
      case "$1" in --style) EXTRA+=(--style "$2"); shift 2 ;; --out) OUTF="$2"; shift 2 ;; --all) EXTRA+=(--all); shift ;; *) NAMES+=("$1"); shift ;; esac
    done
    if [ -z "$OUTF" ]; then
      if [ "$V" = "$REPO/templates/video" ]; then OUTF="${TMPDIR:-/tmp}/lockstep-transitions/transitions${NAMES[0]+_strips}.jpg"; else OUTF="$V/out/transitions${NAMES[0]+_strips}.jpg"; fi
    fi
    ARGS=("$V" transitions --out "$OUTF")
    [ ${#EXTRA[@]} -gt 0 ] && ARGS+=("${EXTRA[@]}")
    [ ${#NAMES[@]} -gt 0 ] && ARGS+=(--names "$(IFS=,; echo "${NAMES[*]}")")
    node "$E/render.js" "${ARGS[@]}" ;;
  preview)      V=$(resolve "${1:-}"); shift; exec node "$E/render.js" "$V" preview "$@" ;;
  still)        V=$(resolve "${1:-}"); shift; node "$E/render.js" "$V" still "$@" ;;
  scan)         V=$(resolve "${1:-}"); node "$E/render.js" "$V" scan ;;
  sheet)
    V=$(resolve "${1:-}"); shift
    COLS=6; if [ "${1:-}" = "--cols" ]; then COLS="$2"; shift 2; fi
    rm -rf "$V/out/sheet_stills"
    node "$E/render.js" "$V" still --out "$V/out/sheet_stills" "$@"
    python3 "$E/sheet.py" "$V/out/sheet_stills/*.jpg" "$V/out/sheet.jpg" "$COLS" 360 ;;
  filmstrip)    V=$(resolve "${1:-}"); shift; python3 "$E/filmstrip.py" "$V" "$V/out/filmstrip.jpg" "$@" ;;
  audio)        V=$(resolve "${1:-}"); python3 "$E/audio/make_audio.py" "$V" ;;
  render)       V=$(resolve "${1:-}"); shift; node "$E/render.js" "$V" video "$@" ;;
  assemble)     V=$(resolve "${1:-}"); shift; python3 "$E/assemble.py" "$V" "$@" ;;
  srt)          V=$(resolve "${1:-}"); python3 "$E/make_srt.py" "$V" ;;
  validate)     V=$(resolve "${1:-}"); shift; python3 "$E/validate.py" "$V" "$@" ;;
  docs)         V=$(resolve "${1:-}"); python3 "$E/make_docs.py" "$V" ;;
  report)       V=$(resolve "${1:-}"); python3 "$E/make_report.py" "$V" ;;
  build)
    V=$(resolve "${1:-}"); shift
    echo "== direction"; python3 "$E/check_brief.py" "$V"; style_gate "$V"
    [ -f "$V/data/words.json" ] || { echo "no narration yet: run 'lockstep voice $(basename "$V")' first" >&2; exit 1; }
    mkdir -p "$V/out"
    echo "== captions"; python3 "$E/make_captions.py" "$V"
    echo "== lint";     python3 "$E/lint.py" "$V"
    echo "== meta";     node "$E/render.js" "$V" meta
    echo "== scan";     node "$E/render.js" "$V" scan
    echo "== audio";    python3 "$E/audio/make_audio.py" "$V" | tail -4
    echo "== render";   node "$E/render.js" "$V" video | tail -1
    echo "== assemble"; python3 "$E/assemble.py" "$V" "$@" 2>&1 | tr '\r' '\n' | grep -v '^frame=' | tail -2
    echo "== srt";      python3 "$E/make_srt.py" "$V" | head -1
    echo "== validate"; python3 "$E/validate.py" "$V" > "$V/out/validate.log" 2>&1 && echo "data/validation.json written" || { tail -5 "$V/out/validate.log"; exit 1; }
    echo "== docs";     python3 "$E/make_docs.py" "$V"
    echo "== credits";  python3 "$E/media.py" credits "$V"
    echo "== report";   python3 "$E/make_report.py" "$V"
    python3 "$E/summary.py" "$V" ;;
  selftest) exec bash "$REPO/scripts/selftest.sh" "$@" ;;
  *) echo "unknown command: $cmd" >&2; usage; exit 1 ;;
esac

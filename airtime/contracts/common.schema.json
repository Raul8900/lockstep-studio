{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airtime.local/contracts/common.schema.json",
  "title": "Shared definitions",
  "$defs": {
    "timestamp": {"type": "string", "format": "date-time", "description": "UTC ISO-8601, e.g. 2026-11-28T17:30:00Z"},
    "ulid_id": {"type": "string", "pattern": "^(prd|opp|brf|sc|upl|lrn|run|job|syn|lease|evt|task)_[0-9A-HJKMNP-TV-Z]{26}$"},
    "market_code": {"type": "string", "pattern": "^[A-Z]{2}$"},
    "language": {"type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})?$"},
    "abs_path": {"type": "string", "pattern": "^/", "description": "Absolute path under AIRTIME_DATA_DIR (or inside a job worktree), valid on the host and in every container"},
    "url": {"type": "string", "pattern": "^https?://"},
    "score": {"type": "number", "minimum": 0, "maximum": 100},
    "market_weight": {
      "type": "object", "required": ["code", "weight"],
      "properties": {"code": {"$ref": "#/$defs/market_code"}, "weight": {"type": "number", "minimum": 0, "maximum": 1}}
    },
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "cache_read_input_tokens": {"type": "integer", "minimum": 0},
        "cache_creation_input_tokens": {"type": "integer", "minimum": 0}
      }
    },
    "error": {
      "type": "object", "required": ["error"],
      "properties": {
        "error": {
          "type": "object", "required": ["code", "message"],
          "properties": {"code": {"type": "string"}, "message": {"type": "string"}, "details": {}}
        }
      }
    },
    "health": {
      "type": "object", "required": ["status", "service", "version"],
      "properties": {"status": {"enum": ["ok", "degraded", "error"]}, "service": {"type": "string"}, "version": {"type": "string"}}
    }
  }
}

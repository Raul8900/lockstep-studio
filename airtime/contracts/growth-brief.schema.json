{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airtime.local/contracts/growth-brief.schema.json",
  "title": "A. GrowthBrief (control → engine-bridge)",
  "description": "What to make and why. engine_request_md is the same brief rendered in the engine's PROMPTING.md template; the structured fields carry the evidence.",
  "type": "object",
  "required": ["schema_version", "brief_id", "created_at", "format", "duration_s", "topic", "angle", "why_now", "audience", "markets", "language", "tone", "hook_options", "title_options", "keywords", "must_include", "avoid", "visual_direction", "give_time_to", "music_mood", "competitors", "learnings", "rubric", "engine_request_md"],
  "properties": {
    "schema_version": {"const": "1"},
    "brief_id": {"type": "string", "pattern": "^brf_"},
    "opportunity_id": {"type": ["string", "null"], "pattern": "^opp_"},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "format": {"enum": ["short", "long"]},
    "duration_s": {
      "type": "object", "required": ["target", "max"],
      "properties": {"target": {"type": "number", "exclusiveMinimum": 0}, "max": {"type": "number", "exclusiveMinimum": 0}}
    },
    "topic": {"type": "string", "minLength": 3},
    "angle": {"type": "string", "minLength": 3},
    "why_now": {"type": "string"},
    "audience": {"type": "string"},
    "markets": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/market_weight"}},
    "language": {"$ref": "common.schema.json#/$defs/language"},
    "tone": {"type": "array", "items": {"type": "string"}},
    "hook_options": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "title_options": {"type": "array", "minItems": 1, "items": {"type": "string", "maxLength": 100}},
    "keywords": {
      "type": "object", "required": ["primary", "secondary"],
      "properties": {"primary": {"type": "array", "items": {"type": "string"}}, "secondary": {"type": "array", "items": {"type": "string"}}}
    },
    "must_include": {"type": "array", "items": {"type": "string"}},
    "avoid": {"type": "array", "items": {"type": "string"}},
    "visual_direction": {"type": "string"},
    "give_time_to": {"type": "array", "items": {"type": "string"}},
    "music_mood": {"type": "string"},
    "competitors": {
      "type": "array",
      "items": {
        "type": "object", "required": ["title", "url"],
        "properties": {
          "title": {"type": "string"}, "url": {"$ref": "common.schema.json#/$defs/url"},
          "views": {"type": ["integer", "null"]}, "age_days": {"type": ["number", "null"]},
          "duration_s": {"type": ["number", "null"]}, "takeaway": {"type": "string"}
        }
      }
    },
    "learnings": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "statement", "weight"],
        "properties": {"id": {"type": "string", "pattern": "^lrn_"}, "statement": {"type": "string"}, "weight": {"type": "number", "minimum": 0, "maximum": 1}}
      }
    },
    "rubric": {
      "type": "object", "required": ["threshold", "dimensions"],
      "properties": {
        "threshold": {"type": "number"},
        "dimensions": {
          "type": "array",
          "items": {"type": "object", "required": ["id", "weight", "what"], "properties": {"id": {"type": "string"}, "weight": {"type": "number"}, "what": {"type": "string"}}}
        }
      }
    },
    "engine_request_md": {"type": "string", "minLength": 20}
  }
}

# Airtime settings. `airtime/scripts/airtime init` writes .env (and .env.fake) with absolute paths
# for this machine; this file documents every key. All services bind 127.0.0.1 only.

# Where things are
AIRTIME_ROOT=/home/owner/lockstep-studio-airtime/airtime
AIRTIME_DATA_DIR=/home/owner/.local/share/airtime        # mounted at the same path in containers
AIRTIME_CONFIG_DIR=/home/owner/lockstep-studio-airtime/airtime/config   # host services; containers use /config
AIRTIME_UID=1000
AIRTIME_GID=1000
AIRTIME_FAKE=0
TZ=Asia/Kolkata

# Claude Code on the host (never in a container). Accounts are in config/claude.yaml.
AIRTIME_MODEL=claude-opus-5-5
AIRTIME_EFFORT=max
AIRTIME_CLAUDE_BIN=/home/owner/.local/bin/claude
AIRTIME_CLAUDE_CONFIG_DIRS=/home/owner/.claude,/home/owner/.claude-second   # engine-bridge's fallback when brain is down
AIRTIME_UV=/home/owner/.local/bin/uv
AIRTIME_HOST_PATH=/home/owner/.local/bin:/usr/local/bin:/usr/bin:/bin  # PATH for the host services

# Ports
CONTROL_PORT=8000
BRAIN_PORT=8001
SCOUT_PORT=8002
YOUTUBE_PORT=8003
ENGINE_BRIDGE_PORT=8004
WEB_PORT=8080
POSTGRES_PORT=5433
POSTGRES_PASSWORD=airtime

# How services find each other
DATABASE_URL=postgresql+psycopg://airtime:airtime@127.0.0.1:5433/airtime
CONTROL_URL=http://127.0.0.1:8000
BRAIN_URL=http://127.0.0.1:8001
SCOUT_URL=http://127.0.0.1:8002
YOUTUBE_URL=http://127.0.0.1:8003
ENGINE_URL=http://127.0.0.1:8004

# YouTube Studio through the owner's Chrome profile (a copy in its own user-data-dir)
CHROME_PROFILE_NAME=Lockstep-Studio
AIRTIME_CHROME_USER_DATA_DIR=/home/owner/.config/airtime-chrome
CHROME_CDP_PORT=9222
CHROME_CDP_URL=http://127.0.0.1:9222

# The engine under test (the engine thread's branch in the owner's main checkout; never written to)
ENGINE_REPO=/home/owner/lockstep-studio
ENGINE_REF=engine
ENGINE_SOURCE=ref                  # ref | working_tree (overlay the checkout's uncommitted work)
ENGINE_ENV_DIR=/home/owner/lockstep-studio   # where .venv, node_modules and models/ come from
ENGINE_MAX_CONCURRENCY=1
ENGINE_JOB_TIMEOUT_MIN=240

# The native Docker Engine, not Docker Desktop
DOCKER_CONTEXT=default

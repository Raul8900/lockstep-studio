 "takes": [
  {
   "take": 0,
   "beat": "hook",
   "text": "At thirty-five thousand feet, why put a hole in a pressurized window?",
   "t0": 0.3119,
   "t1": 4.3119,
   "pause_after": 0.45
  },
  {
   "take": 1,
   "beat": "layers",
   "text": "In this Airbus design, look through the scratch pane you can touch.",
   "t0": 4.9397,
   "t1": 8.3147,
   "pause_after": 0.25
  },
  {
   "take": 2,
   "beat": "layers",
   "text": "Behind it, a tiny vent pierces the inner windowpane. Beyond that is the outer windowpane.",
   "t0": 8.7102,
   "t1": 14.1602,
   "pause_after": 1.5
  },
  {
   "take": 3,
   "beat": "pressure",
   "text": "The vent lets cabin air into the gap between the structural panes. It is not a hole to the outside.",
   "t0": 15.8237,
   "t1": 21.4237,
   "pause_after": 0.35
  },
  {
   "take": 4,
   "beat": "pressure",
   "text": "That puts cabin pressure on both sides of the inner pane. The outer pane normally carries the pressure difference.",
   "t0": 21.9342,
   "t1": 28.1842,
   "pause_after": 0.5
  },
  {
   "take": 5,
   "beat": "backup",
   "text": "If the outer windowpane fails, the inner windowpane can take the pressure load.",
   "t0": 28.8313,
   "t1": 33.3563,
   "pause_after": 0.25
  },
  {
   "take": 6,
   "beat": "backup",
   "text": "The scratch pane protects against passenger contact. Three layers. Different jobs.",
   "t0": 33.7699,
   "t1": 38.6949,
   "pause_after": 0.3
  }
 ]

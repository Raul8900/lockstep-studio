 "takes": [
  {
   "take": 0,
   "beat": "hook",
   "text": "At thirty-five thousand feet, why put a hole in a pressurised window?",
   "t0": 0.3119,
   "t1": 4.3119,
   "pause_after": 0.45
  },
  {
   "take": 1,
   "beat": "layers",
   "text": "In this Airbus design, look through the scratch pane you can touch.",
   "t0": 4.9397,
   "t1": 8.3147,
   "pause_after": 0.25
  },
  {
   "take": 2,
   "beat": "layers",
   "text": "Behind it, the inner structural pane has the tiny vent. Then comes the outer structural pane.",
   "t0": 8.7102,
   "t1": 14.5102,
   "pause_after": 1.5
  },
  {
   "take": 3,
   "beat": "pressure",
   "text": "The vent lets cabin air into the gap between the structural panes. It is not a hole to the outside.",
   "t0": 16.1737,
   "t1": 21.7737,
   "pause_after": 0.35
  },
  {
   "take": 4,
   "beat": "pressure",
   "text": "That puts cabin pressure on both sides of the inner pane. The outer pane normally carries the pressure difference.",
   "t0": 22.2843,
   "t1": 28.5343,
   "pause_after": 0.5
  },
  {
   "take": 5,
   "beat": "backup",
   "text": "If the outer pane fails, the inner structural pane can take the pressure load.",
   "t0": 29.1821,
   "t1": 33.6821,
   "pause_after": 0.25
  },
  {
   "take": 6,
   "beat": "backup",
   "text": "The scratch pane protects against passenger contact. Three layers. Different jobs.",
   "t0": 34.0957,
   "t1": 39.0207,
   "pause_after": 0.3
  }
 ]

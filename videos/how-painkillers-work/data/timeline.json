 "caps": [
  {
   "text": "Your painkiller",
   "show0": 0.2982,
   "show1": 1.0231999999999999,
   "t0": 0.3582,
   "t1": 1.0332,
   "lines": 1,
   "width": 573.9060592651367
  },
  {
   "text": "knows where it hurts.",
   "show0": 1.0231999999999999,
   "show1": 2.5235,
   "t0": 1.0832,
   "t1": 2.2082,
   "lines": 2,
   "width": 503.45821380615234
  },
  {
   "text": "It doesn't.",
   "show0": 2.5235,
   "show1": 3.7235,
   "t0": 2.5835,
   "t1": 3.3835,
   "lines": 1,
   "width": 357.1604232788086
  },
  {
   "text": "It seems to.",
   "show0": 4.2216000000000005,
   "show1": 5.656000000000001,
   "t0": 4.2816,
   "t1": 5.2066,
   "lines": 1,
   "width": 419.6533203125
  },
  {
   "text": "You swallow one,",
   "show0": 5.656000000000001,
   "show1": 6.581,
   "t0": 5.716,
   "t1": 6.541,
   "lines": 1,
   "width": 631.3300018310547
  },
  {
   "text": "the ankle feels better,",
   "show0": 6.581,
   "show1": 7.906000000000001,
   "t0": 6.641,
   "t1": 7.841,
   "lines": 2,
   "width": 431.23429107666016
  },
  {
   "text": "so the pill must",
   "show0": 7.906000000000001,
   "show1": 8.581,
   "t0": 7.966,
   "t1": 8.616,
   "lines": 1,
   "width": 591.9620590209961
  },
  {
   "text": "have gone there.",
   "show0": 8.581,
   "show1": 9.831,
   "t0": 8.641,
   "t1": 9.491,
   "lines": 1,
   "width": 604.5790252685547
  },
  {
   "text": "The pill dissolves",
   "show0": 10.337399999999999,
   "show1": 11.4124,
   "t0": 10.3974,
   "t1": 11.3974,
   "lines": 1,
   "width": 657.7479400634766
  },
  {
   "text": "and passes into your blood.",
   "show0": 11.4124,
   "show1": 13.283,
   "t0": 11.4724,
   "t1": 12.8474,
   "lines": 2,
   "width": 586.1900787353516
  },
  {
   "text": "Its level peaks",
   "show0": 13.283,
   "show1": 14.232999999999999,
   "t0": 13.343,
   "t1": 14.243,
   "lines": 1,
   "width": 542.8631134033203
  },
  {
   "text": "within one to two hours.",
   "show0": 14.232999999999999,
   "show1": 16.008000000000003,
   "t0": 14.293,
   "t1": 15.943,
   "lines": 2,
   "width": 485.4392547607422
  },
  {
   "text": "It sticks to blood proteins,",
   "show0": 16.008000000000003,
   "show1": 17.758000000000003,
   "t0": 16.068,
   "t1": 17.693,
   "lines": 2,
   "width": 552.520149230957
  },
  {
   "text": "so it mostly stays",
   "show0": 17.758000000000003,
   "show1": 18.708000000000002,
   "t0": 17.818,
   "t1": 18.743,
   "lines": 1,
   "width": 664.0379409790039
  },
  {
   "text": "in the bloodstream.",
   "show0": 18.708000000000002,
   "show1": 20.158,
   "t0": 18.768,
   "t1": 19.818,
   "lines": 1,
   "width": 721.0918426513672
  },
  {
   "text": "Blood reaches every organ,",
   "show0": 20.410700000000002,
   "show1": 22.085700000000003,
   "t0": 20.4707,
   "t1": 22.0207,
   "lines": 2,
   "width": 535.5371475219727
  },
  {
   "text": "and the drug",
   "show0": 22.085700000000003,
   "show1": 22.585700000000003,
   "t0": 22.1457,
   "t1": 22.5957,
   "lines": 1,
   "width": 489.6572265625
  },
  {
   "text": "travels with it.",
   "show0": 22.585700000000003,
   "show1": 23.9607,
   "t0": 22.6457,
   "t1": 23.6207,
   "lines": 1,
   "width": 534.5011291503906
  },
  {
   "text": "Hurt tissue switches on",
   "show0": 24.473000000000003,
   "show1": 25.548000000000002,
   "t0": 24.533,
   "t1": 25.583,
   "lines": 2,
   "width": 447.58829498291016
  },
  {
   "text": "an enzyme called COX-2.",
   "show0": 25.548000000000002,
   "show1": 27.398,
   "t0": 25.608,
   "t1": 27.283,
   "lines": 2,
   "width": 492.17317962646484
  },
  {
   "text": "It makes prostaglandins.",
   "show0": 27.398,
   "show1": 29.4216,
   "t0": 27.458,
   "t1": 28.983,
   "lines": 2,
   "width": 570.8720703125
  },
  {
   "text": "They make nerves more sensitive",
   "show0": 29.4216,
   "show1": 31.146600000000003,
   "t0": 29.4816,
   "t1": 31.1566,
   "lines": 2,
   "width": 691.3068695068359
  },
  {
   "text": "to the chemicals",
   "show0": 31.146600000000003,
   "show1": 31.846600000000002,
   "t0": 31.2066,
   "t1": 31.8316,
   "lines": 1,
   "width": 622.9309844970703
  },
  {
   "text": "injury releases.",
   "show0": 31.846600000000002,
   "show1": 33.421600000000005,
   "t0": 31.9066,
   "t1": 33.0816,
   "lines": 1,
   "width": 561.3260879516602
  },
  {
   "text": "Ibuprofen blocks both",
   "show0": 33.6817,
   "show1": 35.0817,
   "t0": 33.7417,
   "t1": 35.0917,
   "lines": 2,
   "width": 441.9273147583008
  },
  {
   "text": "versions of that enzyme,",
   "show0": 35.0817,
   "show1": 36.5317,
   "t0": 35.1417,
   "t1": 36.4417,
   "lines": 2,
   "width": 466.97623443603516
  },
  {
   "text": "everywhere it works.",
   "show0": 36.5317,
   "show1": 38.0067,
   "t0": 36.5917,
   "t1": 37.6667,
   "lines": 1,
   "width": 778.4047546386719
  },
  {
   "text": "The sore ankle is where",
   "show0": 38.26,
   "show1": 39.309999999999995,
   "t0": 38.32,
   "t1": 39.32,
   "lines": 2,
   "width": 551.6321105957031
  },
  {
   "text": "that enzyme is busiest,",
   "show0": 39.309999999999995,
   "show1": 41.035,
   "t0": 39.37,
   "t1": 40.97,
   "lines": 2,
   "width": 466.97623443603516
  },
  {
   "text": "so the block removes",
   "show0": 41.035,
   "show1": 42.035,
   "t0": 41.095,
   "t1": 42.07,
   "lines": 2,
   "width": 458.50328063964844
  },
  {
   "text": "the most there.",
   "show0": 42.035,
   "show1": 43.31,
   "t0": 42.095,
   "t1": 42.97,
   "lines": 1,
   "width": 558.5511016845703
  },
  {
   "text": "The same block",
   "show0": 43.813399999999994,
   "show1": 44.688399999999994,
   "t0": 43.8734,
   "t1": 44.6734,
   "lines": 1,
   "width": 593.6270446777344
  },
  {
   "text": "runs everywhere.",
   "show0": 44.688399999999994,
   "show1": 46.038399999999996,
   "t0": 44.7484,
   "t1": 45.8984,
   "lines": 1,
   "width": 639.3219833374023
  },
  {
   "text": "Your stomach makes its own",
   "show0": 46.038399999999996,
   "show1": 47.3384,
   "t0": 46.0984,
   "t1": 47.3484,
   "lines": 2,
   "width": 545.3051300048828
  },
  {
   "text": "prostaglandins to help",
   "show0": 47.3384,
   "show1": 48.5884,
   "t0": 47.3984,
   "t1": 48.5984,
   "lines": 2,
   "width": 570.8720703125
  },
  {
   "text": "guard its lining.",
   "show0": 48.5884,
   "show1": 50.1132,
   "t0": 48.6484,
   "t1": 49.6234,
   "lines": 1,
   "width": 585.3760681152344
  },
  {
   "text": "Block it, and ulcers",
   "show0": 50.1132,
   "show1": 51.288199999999996,
   "t0": 50.1732,
   "t1": 51.3232,
   "lines": 1,
   "width": 714.8388595581055
  },
  {
   "text": "and bleeding can happen.",
   "show0": 51.288199999999996,
   "show1": 52.6132,
   "t0": 51.3482,
   "t1": 52.5232,
   "lines": 2,
   "width": 486.4382095336914
  },
  {
   "text": "The label calls them",
   "show0": 52.6132,
   "show1": 53.563199999999995,
   "t0": 52.6732,
   "t1": 53.5482,
   "lines": 1,
   "width": 765.1587448120117
  },
  {
   "text": "serious.",
   "show0": 53.563199999999995,
   "show1": 54.6882,
   "t0": 53.6232,
   "t1": 54.3482,
   "lines": 1,
   "width": 275.72357177734375
  },
  {
   "text": "Your kidneys use",
   "show0": 54.9415,
   "show1": 55.8165,
   "t0": 55.0015,
   "t1": 55.8265,
   "lines": 1,
   "width": 648.9419860839844
  },
  {
   "text": "prostaglandins to keep",
   "show0": 55.8165,
   "show1": 57.0415,
   "t0": 55.8765,
   "t1": 57.0515,
   "lines": 2,
   "width": 570.8720703125
  },
  {
   "text": "blood flowing.",
   "show0": 57.0415,
   "show1": 58.216499999999996,
   "t0": 57.1015,
   "t1": 58.1265,
   "lines": 1,
   "width": 522.1061782836914
  },
  {
   "text": "In people with",
   "show0": 58.216499999999996,
   "show1": 58.866499999999995,
   "t0": 58.2765,
   "t1": 58.8765,
   "lines": 1,
   "width": 549.1901245117188
  },
  {
   "text": "kidney problems,",
   "show0": 58.866499999999995,
   "show1": 59.991499999999995,
   "t0": 58.9265,
   "t1": 59.9265,
   "lines": 1,
   "width": 636.4359970092773
  },
  {
   "text": "ibuprofen can cut that flow.",
   "show0": 59.991499999999995,
   "show1": 62.3915,
   "t0": 60.0515,
   "t1": 62.0515,
   "lines": 2,
   "width": 533.5391616821289
  },
  {
   "text": "Not every painkiller",
   "show0": 62.919,
   "show1": 64.044,
   "t0": 62.979,
   "t1": 64.054,
   "lines": 1,
   "width": 756.9077453613281
  },
  {
   "text": "plays this game.",
   "show0": 64.044,
   "show1": 65.6224,
   "t0": 64.104,
   "t1": 65.129,
   "lines": 1,
   "width": 593.4050445556641
  },
  {
   "text": "Paracetamol,",
   "show0": 65.6224,
   "show1": 66.5474,
   "t0": 65.6824,
   "t1": 66.5074,
   "lines": 1,
   "width": 481.70220947265625
  },
  {
   "text": "or acetaminophen,",
   "show0": 66.5474,
   "show1": 67.7474,
   "t0": 66.6074,
   "t1": 67.6824,
   "lines": 1,
   "width": 689.7528762817383
  },
  {
   "text": "has almost no",
   "show0": 67.7474,
   "show1": 68.6224,
   "t0": 67.8074,
   "t1": 68.6074,
   "lines": 1,
   "width": 530.9861602783203
  },
  {
   "text": "anti-inflammatory effect.",
   "show0": 68.6224,
   "show1": 70.84689999999999,
   "t0": 68.6824,
   "t1": 70.4074,
   "lines": 2,
   "width": 706.6988525390625
  },
  {
   "text": "It works mostly in",
   "show0": 70.84689999999999,
   "show1": 71.72189999999999,
   "t0": 70.9069,
   "t1": 71.7569,
   "lines": 1,
   "width": 701.8148880004883
  },
  {
   "text": "the brain and spinal cord.",
   "show0": 71.72189999999999,
   "show1": 73.5719,
   "t0": 71.7819,
   "t1": 73.4069,
   "lines": 2,
   "width": 513.8181762695312
  },
  {
   "text": "Scientists still argue",
   "show0": 73.5719,
   "show1": 74.6969,
   "t0": 73.6319,
   "t1": 74.7069,
   "lines": 1,
   "width": 777.5907592773438
  },
  {
   "text": "about exactly how.",
   "show0": 74.6969,
   "show1": 76.3469,
   "t0": 74.7569,
   "t1": 76.0069,
   "lines": 1,
   "width": 691.7508850097656
  },
  {
   "text": "Opioids like morphine",
   "show0": 76.6033,
   "show1": 77.9033,
   "t0": 76.6633,
   "t1": 77.9133,
   "lines": 2,
   "width": 452.5462417602539
  },
  {
   "text": "work largely through",
   "show0": 77.9033,
   "show1": 78.8533,
   "t0": 77.9633,
   "t1": 78.8883,
   "lines": 2,
   "width": 481.7022171020508
  },
  {
   "text": "the nervous system.",
   "show0": 78.8533,
   "show1": 80.30330000000001,
   "t0": 78.9133,
   "t1": 79.9633,
   "lines": 1,
   "width": 739.0368499755859
  },
  {
   "text": "So it doesn't know",
   "show0": 80.84949999999999,
   "show1": 81.5245,
   "t0": 80.9095,
   "t1": 81.5345,
   "lines": 1,
   "width": 695.6359024047852
  },

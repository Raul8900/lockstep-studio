   "show1": 29.065,
   "t0": 28.5,
   "t1": 29.075,
   "lines": 1,
   "width": 432.72015380859375
  },
  {
   "text": "and pushed it further.",
   "show0": 29.065,
   "show1": 30.4679,
   "t0": 29.125,
   "t1": 30.175,
   "lines": 1,
   "width": 808.308219909668
  },
  {

   "show1": 4.790500000000001,
   "t0": 3.498,
   "t1": 4.448,
   "lines": 1,
   "width": 628.7042236328125
  },
  {
   "text": "Locals called it",
   "show0": 4.790500000000001,
   "show1": 5.5905000000000005,
   "t0": 4.8505,
   "t1": 5.6005,
   "lines": 1,
   "width": 560.9522094726562
  },
  {
   "text": "Galloping Gertie,",
   "show0": 5.5905000000000005,
   "show1": 6.740500000000001,
   "t0": 5.6505,
   "t1": 6.6755,
   "lines": 1,
   "width": 611.6042098999023
  },
  {
   "text": "and people drove across",
   "show0": 6.740500000000001,
   "show1": 7.865500000000001,
   "t0": 6.8005,
   "t1": 7.8505,
   "lines": 2,
   "width": 491.07616424560547
  },
  {
   "text": "just to feel it bounce.",
   "show0": 7.865500000000001,
   "show1": 9.5505,
   "t0": 7.9255,
   "t1": 9.1255,
   "lines": 1,
   "width": 773.1362457275391
  },
  {
   "text": "Its main span",
   "show0": 9.5505,
   "show1": 10.375499999999999,
   "t0": 9.6105,
   "t1": 10.4105,
   "lines": 1,
   "width": 520.2001800537109
  },
  {
   "text": "was over half",
   "show0": 10.375499999999999,
   "show1": 10.9255,
   "t0": 10.4355,
   "t1": 10.9605,
   "lines": 1,
   "width": 511.27215576171875
  },
  {
   "text": "a mile long,",
   "show0": 10.9255,
   "show1": 11.8005,
   "t0": 10.9855,
   "t1": 11.7605,
   "lines": 1,
   "width": 422.0641632080078
  },
  {
   "text": "but its deck",
   "show0": 11.8005,
   "show1": 12.3505,
   "t0": 11.8605,
   "t1": 12.3855,
   "lines": 1,
   "width": 446.9041442871094
  },
  {
   "text": "was only eight feet deep.",
   "show0": 12.3505,
   "show1": 14.1319,
   "t0": 12.4105,
   "t1": 13.8355,
   "lines": 2,
   "width": 554.544189453125
  },
  {
   "text": "In the wind,",
   "show0": 14.1319,
   "show1": 14.8319,
   "t0": 14.1919,
   "t1": 14.7919,
   "lines": 1,
   "width": 421.1281280517578
  },
  {
   "text": "it rippled like a ribbon.",
   "show0": 14.8319,
   "show1": 16.517000000000003,
   "t0": 14.8919,
   "t1": 16.0919,
   "lines": 2,
   "width": 472.9681701660156
  },
  {
   "text": "On November seventh,",
   "show0": 16.517000000000003,

   "t1": 22.702,
   "lines": 1,
   "width": 538.6322021484375
  },
  {
   "text": "Then the motion changed.",
   "show0": 23.0931,
   "show1": 24.4431,
   "t0": 23.1531,
   "t1": 24.3031,
   "lines": 2,
   "width": 622.2242279052734
  },
  {
   "text": "The bounce",
   "show0": 24.4431,

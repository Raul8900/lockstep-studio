 "caps": [
  {
   "text": "In 1940,",
   "show0": 0.238,
   "show1": 1.438,
   "t0": 0.298,
   "t1": 1.373,
   "lines": 1,
   "width": 260.74808502197266
  },
  {
   "text": "a brand-new bridge",
   "show0": 1.438,
   "show1": 2.388,
   "t0": 1.498,
   "t1": 2.398,
   "lines": 1,
   "width": 763.3442535400391
  },
  {
   "text": "in Washington State",
   "show0": 2.388,
   "show1": 3.438,
   "t0": 2.448,
   "t1": 3.448,
   "lines": 1,
   "width": 774.1442718505859
  },
  {
   "text": "started to dance.",

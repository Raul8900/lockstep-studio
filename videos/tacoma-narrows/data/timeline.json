   "show0": 24.868100000000002,
   "show1": 26.39,
   "t0": 24.9281,
   "t1": 26.1031,
   "lines": 1,
   "width": 700.5242233276367
  },
  {
   "text": "As the deck tilted,",
   "show0": 26.39,

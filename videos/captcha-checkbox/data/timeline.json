   "show0": 13.1252,
   "show1": 14.200199999999999,
   "t0": 13.1852,
   "t1": 14.1852,
   "lines": 1,
   "width": 548.26123046875
  },
  {
   "text": "everything you do",
   "show0": 14.200199999999999,

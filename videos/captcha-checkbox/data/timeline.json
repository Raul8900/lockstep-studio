   "show0": 8.9817,
   "show1": 10.6752,
   "t0": 9.0417,
   "t1": 10.1417,
   "lines": 1,
   "width": 507.68408203125
  },
  {
   "text": "In 2013,",
   "show0": 10.6752,
   "show1": 12.1002,
   "t0": 10.7352,
   "t1": 11.9852,
   "lines": 1,
   "width": 257.39208984375
  },
  {
   "text": "Google said its risk",
   "show0": 12.1002,
   "show1": 13.1252,
   "t0": 12.1602,
   "t1": 13.1352,
   "lines": 1,
   "width": 681.30224609375
  },
  {
   "text": "analysis covers",
   "show0": 13.1252,
   "show1": 14.200199999999999,
   "t0": 13.1852,
   "t1": 14.1852,
   "lines": 1,
   "width": 548.26123046875
  },
  {
   "text": "everything you do",
   "show0": 14.200199999999999,
   "show1": 15.0252,
   "t0": 14.2602,
   "t1": 15.0352,
   "lines": 1,
   "width": 643.525390625
  },
  {

   "t1": 10.1417,
   "lines": 1,
   "width": 507.68408203125
  },
  {
   "text": "In twenty thirteen,",
   "show0": 10.6752,
   "show1": 12.1002,
   "t0": 10.7352,
   "t1": 11.9852,
   "lines": 1,
   "width": 642.2607421875
  },
  {
   "text": "Google said its risk",
   "show0": 12.1002,

 "caps": [
  {
   "text": "This chip has",
   "show0": 0.3279,
   "show1": 0.9779,
   "t0": 0.3879,
   "t1": 1.0129,
   "lines": 1,
   "width": 473.1953125
  },
  {
   "text": "over twenty thousand",
   "show0": 0.9779,
   "show1": 1.9529,
   "t0": 1.0379,
   "t1": 1.9629,
   "lines": 1,
   "width": 785.0576171875
  },
  {
   "text": "cores.",
   "show0": 1.9529,
   "show1": 3.0945,
   "t0": 2.0129,
   "t1": 2.6629,
   "lines": 1,
   "width": 197.068359375
  },
  {
   "text": "And not one of them",
   "show0": 3.0945,
   "show1": 3.9694999999999996,
   "t0": 3.1545,
   "t1": 3.9795,
   "lines": 1,
   "width": 736.8564453125
  },
  {
   "text": "can think",
   "show0": 3.9694999999999996,
   "show1": 4.4195,
   "t0": 4.0295,
   "t1": 4.4295,
   "lines": 1,
   "width": 330.70556640625
  },
  {
   "text": "for itself.",
   "show0": 4.4195,
   "show1": 5.8256000000000006,
   "t0": 4.4795,
   "t1": 5.3545,
   "lines": 1,
   "width": 303.10009765625
  },
  {
   "text": "That's exactly why",
   "show0": 5.8256000000000006,
   "show1": 6.8256000000000006,
   "t0": 5.8856,
   "t1": 6.8606,
   "lines": 1,
   "width": 670.3720703125
  },
  {
   "text": "it's so fast.",
   "show0": 6.8256000000000006,
   "show1": 8.2006,
   "t0": 6.8856,
   "t1": 7.8606,
   "lines": 1,
   "width": 375.05859375
  },
  {
   "text": "A CPU is built",
   "show0": 8.727,
   "show1": 9.927,
   "t0": 8.787,
   "t1": 9.937,
   "lines": 1,
   "width": 491.38818359375
  },
  {
   "text": "for decisions.",
   "show0": 9.927,
   "show1": 11.3083,
   "t0": 9.987,
   "t1": 10.912,
   "lines": 1,
   "width": 460.24169921875
  },
  {
   "text": "A few brilliant cores,",
   "show0": 11.3083,
   "show1": 12.9583,
   "t0": 11.3683,
   "t1": 12.8433,
   "lines": 1,
   "width": 718.66357421875
  },
  {
   "text": "each spending",
   "show0": 12.9583,
   "show1": 13.5833,
   "t0": 13.0183,
   "t1": 13.5933,
   "lines": 1,
   "width": 519.75244140625
  },
  {
   "text": "most of its silicon",
   "show0": 13.5833,
   "show1": 14.5583,
   "t0": 13.6433,
   "t1": 14.5933,
   "lines": 1,
   "width": 636.60595703125
  },
  {
   "text": "on prediction,",
   "show0": 14.5583,
   "show1": 15.5583,
   "t0": 14.6183,
   "t1": 15.4683,
   "lines": 1,
   "width": 470.39501953125
  },
  {
   "text": "caching,",
   "show0": 15.5583,
   "show1": 16.133300000000002,
   "t0": 15.6183,
   "t1": 16.1183,
   "lines": 1,
   "width": 280.2822265625
  },
  {
   "text": "and control—",
   "show0": 16.133300000000002,
   "show1": 17.258300000000002,
   "t0": 16.1933,
   "t1": 17.1683,
   "lines": 1,
   "width": 405.50048828125
  },
  {
   "text": "to finish one task",
   "show0": 17.258300000000002,
   "show1": 18.4583,
   "t0": 17.3183,
   "t1": 18.4433,
   "lines": 1,
   "width": 620.02099609375
  },
  {
   "text": "as fast as possible.",
   "show0": 18.4583,
   "show1": 20.2833,
   "t0": 18.5183,
   "t1": 19.9433,
   "lines": 1,
   "width": 664.64501953125
  },
  {
   "text": "A GPU makes",
   "show0": 20.608700000000002,
   "show1": 21.5837,
   "t0": 20.6687,
   "t1": 21.6187,
   "lines": 1,
   "width": 484.2158203125
  },
  {
   "text": "the opposite bet.",
   "show0": 21.5837,
   "show1": 23.1387,
   "t0": 21.6437,
   "t1": 22.7687,
   "lines": 1,
   "width": 585.423828125
  },
  {
   "text": "It strips most of",
   "show0": 23.1387,
   "show1": 24.0637,
   "t0": 23.1987,
   "t1": 24.0737,
   "lines": 1,
   "width": 573.01220703125
  },
  {
   "text": "that cleverness out,",
   "show0": 24.0637,
   "show1": 25.3137,
   "t0": 24.1237,
   "t1": 25.2487,
   "lines": 1,
   "width": 688.474609375
  },
  {
   "text": "and spends the silicon",
   "show0": 25.3137,
   "show1": 26.463700000000003,
   "t0": 25.3737,
   "t1": 26.4737,
   "lines": 1,
   "width": 799.27587890625
  },
  {
   "text": "on raw arithmetic—",
   "show0": 26.463700000000003,
   "show1": 27.9887,
   "t0": 26.5237,
   "t1": 27.8987,
   "lines": 1,
   "width": 630.5537109375
  },
  {
   "text": "copied",
   "show0": 27.9887,
   "show1": 28.413700000000002,
   "t0": 28.0487,
   "t1": 28.3987,
   "lines": 1,
   "width": 238.04296875
  },
  {
   "text": "thousands of times.",
   "show0": 28.413700000000002,
   "show1": 30.0637,
   "t0": 28.4737,
   "t1": 29.7237,
   "lines": 1,
   "width": 688.1494140625
  },
  {
   "text": "It doesn't even run",
   "show0": 30.508100000000002,
   "show1": 31.3581,
   "t0": 30.5681,
   "t1": 31.3931,
   "lines": 1,
   "width": 665.58447265625
  },
  {
   "text": "your program.",
   "show0": 31.3581,
   "show1": 32.3531,
   "t0": 31.4181,
   "t1": 32.1931,
   "lines": 1,
   "width": 481.48779296875
  },
  {
   "text": "The CPU does.",
   "show0": 32.3531,
   "show1": 34.092999999999996,
   "t0": 32.4131,
   "t1": 33.6631,
   "lines": 1,
   "width": 503.40234375
  },
  {
   "text": "It copies your data",
   "show0": 34.092999999999996,
   "show1": 35.092999999999996,
   "t0": 34.153,
   "t1": 35.103,
   "lines": 1,
   "width": 665.76513671875
  },
  {
   "text": "into the GPU's memory,",
   "show0": 35.092999999999996,
   "show1": 36.768,
   "t0": 35.153,
   "t1": 36.703,
   "lines": 2,
   "width": 509.255859375
  },
  {
   "text": "then sends",
   "show0": 36.768,
   "show1": 37.367999999999995,
   "t0": 36.828,
   "t1": 37.353,
   "lines": 1,
   "width": 394.15478515625
  },
  {
   "text": "one small function,",
   "show0": 37.367999999999995,
   "show1": 38.543,
   "t0": 37.428,
   "t1": 38.503,
   "lines": 1,
   "width": 659.49609375
  },
  {
   "text": "with a single order:",
   "show0": 38.543,
   "show1": 40.193,
   "t0": 38.603,
   "t1": 40.003,
   "lines": 1,
   "width": 664.42822265625
  },
  {
   "text": "run this,",
   "show0": 40.193,
   "show1": 40.918,
   "t0": 40.253,
   "t1": 40.853,
   "lines": 1,
   "width": 272.96533203125
  },
  {
   "text": "a million times.",
   "show0": 40.918,
   "show1": 42.518,
   "t0": 40.978,
   "t1": 42.178,
   "lines": 1,
   "width": 516.193359375
  },
  {
   "text": "Zoom into the chip,",
   "show0": 43.0683,
   "show1": 44.1933,
   "t0": 43.1283,
   "t1": 44.1283,
   "lines": 1,
   "width": 671.87158203125
  },
  {
   "text": "and you find",

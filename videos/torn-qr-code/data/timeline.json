 "caps": [
  {
   "text": "I just tore a chunk",
   "show0": 0.285,
   "show1": 1.1099999999999999,
   "t0": 0.345,
   "t1": 1.145,
   "lines": 1,
   "width": 691.8278045654297
  },
  {
   "text": "off this QR code.",
   "show0": 1.1099999999999999,
   "show1": 2.635,
   "t0": 1.17,
   "t1": 2.395,
   "lines": 1,
   "width": 616.0178146362305
  },
  {
   "text": "It still scans.",
   "show0": 2.635,
   "show1": 4.378900000000001,
   "t0": 2.695,
   "t1": 3.895,
   "lines": 1,
   "width": 465.4238739013672
  },
  {
   "text": "That's because",
   "show0": 4.378900000000001,
   "show1": 5.0789,
   "t0": 4.4389,
   "t1": 5.0639,
   "lines": 1,
   "width": 588.0498275756836
  },
  {
   "text": "most of it isn't",
   "show0": 5.0789,
   "show1": 5.9539,
   "t0": 5.1389,
   "t1": 5.9889,
   "lines": 1,
   "width": 546.4778518676758
  },
  {
   "text": "your message at all.",
   "show0": 5.9539,
   "show1": 7.5289,
   "t0": 6.0139,
   "t1": 7.1889,
   "lines": 1,
   "width": 750.0817794799805
  },
  {
   "text": "So what's the rest?",
   "show0": 7.9647,
   "show1": 9.0648,
   "t0": 8.0247,
   "t1": 8.9247,
   "lines": 1,
   "width": 740.1257858276367
  },
  {
   "text": "A backup copy?",
   "show0": 9.0648,
   "show1": 10.7883,
   "t0": 9.1248,
   "t1": 10.3498,
   "lines": 1,
   "width": 616.5117797851562
  },
  {
   "text": "Smudge one letter,",
   "show0": 10.7883,
   "show1": 11.9133,
   "t0": 10.8483,
   "t1": 11.8483,
   "lines": 1,
   "width": 706.7998199462891
  },
  {
   "text": "and the two copies",
   "show0": 11.9133,
   "show1": 12.738299999999999,
   "t0": 11.9733,
   "t1": 12.7483,
   "lines": 1,
   "width": 730.0937881469727
  },
  {
   "text": "disagree.",
   "show0": 12.738299999999999,
   "show1": 14.046299999999999,
   "t0": 12.7983,
   "t1": 13.6733,
   "lines": 1,
   "width": 333.10791015625
  },
  {
   "text": "Which one's right?",
   "show0": 14.046299999999999,
   "show1": 15.071299999999999,
   "t0": 14.1063,
   "t1": 14.9313,
   "lines": 1,
   "width": 711.8917846679688
  },
  {
   "text": "Copies can't tell you.",
   "show0": 15.071299999999999,
   "show1": 16.983,
   "t0": 15.1313,
   "t1": 16.4313,
   "lines": 1,
   "width": 781.2417984008789
  },
  {
   "text": "Reed-Solomon codes,",
   "show0": 16.983,
   "show1": 18.108,
   "t0": 17.043,
   "t1": 18.118,
   "lines": 2,
   "width": 562.0198364257812
  },
  {
   "text": "from 1960,",
   "show0": 18.108,
   "show1": 19.333000000000002,
   "t0": 18.168,
   "t1": 19.268,
   "lines": 1,
   "width": 387.94188690185547
  },
  {
   "text": "do something smarter.",
   "show0": 19.333000000000002,
   "show1": 21.008,
   "t0": 19.393,
   "t1": 20.668,
   "lines": 2,
   "width": 523.2218246459961
  },
  {
   "text": "Say your message",
   "show0": 21.4338,
   "show1": 22.108800000000002,
   "t0": 21.4938,
   "t1": 22.1188,
   "lines": 1,
   "width": 705.27978515625
  },
  {
   "text": "is just two numbers.",
   "show0": 22.108800000000002,
   "show1": 23.770200000000003,
   "t0": 22.1688,
   "t1": 23.3938,
   "lines": 1,
   "width": 753.045783996582
  },
  {
   "text": "Two dots fix",
   "show0": 23.770200000000003,
   "show1": 24.5702,
   "t0": 23.8302,
   "t1": 24.5802,
   "lines": 1,
   "width": 470.8198547363281
  },
  {
   "text": "exactly one line.",
   "show0": 24.5702,
   "show1": 26.3702,
   "t0": 24.6302,
   "t1": 26.0302,
   "lines": 1,
   "width": 603.9718170166016
  },
  {
   "text": "Now add extra dots",
   "show0": 26.685100000000002,
   "show1": 27.7601,
   "t0": 26.7451,

 "takes": [
  {
   "take": 0,
   "beat": "hook",
   "text": "I just tore a chunk off this QR code. It still scans.",
   "t0": 0.345,
   "t1": 3.895,
   "pause_after": 0.4
  },
  {
   "take": 1,
   "beat": "hook",
   "text": "That's because most of it isn't your message at all.",
   "t0": 4.4389,
   "t1": 7.1889,
   "pause_after": 0.65
  },
  {
   "take": 2,
   "beat": "copies",
   "text": "So what's the rest? A backup copy?",
   "t0": 8.0247,
   "t1": 10.3498,
   "pause_after": 0.3
  },
  {
   "take": 3,
   "beat": "copies",
   "text": "Smudge one letter, and the two copies disagree.",
   "t0": 10.8483,
   "t1": 13.6733,
   "pause_after": 0.28
  },
  {
   "take": 4,
   "beat": "copies",
   "text": "Which one's right? Copies can't tell you.",
   "t0": 14.1063,
   "t1": 16.4313,
   "pause_after": 0.45
  },
  {
   "take": 5,
   "beat": "copies",
   "text": "Reed-Solomon codes, from 1960, do something smarter.",
   "t0": 17.043,
   "t1": 20.668,
   "pause_after": 0.65
  },
  {
   "take": 6,
   "beat": "curve",
   "text": "Say your message is just two numbers.",
   "t0": 21.4938,
   "t1": 23.3938,
   "pause_after": 0.28
  },
  {
   "take": 7,
   "beat": "curve",
   "text": "Two dots fix exactly one line.",
   "t0": 23.8302,
   "t1": 26.0302,
   "pause_after": 0.55
  },
  {
   "take": 8,
   "beat": "curve",
   "text": "Now add extra dots on that same line.",
   "t0": 26.7451,
   "t1": 29.0451,
   "pause_after": 0.35
  },
  {
   "take": 9,
   "beat": "curve",
   "text": "Tear any two away: the survivors still fix the line, and it puts the missing dots back.",
   "t0": 29.5595,
   "t1": 34.6845,
   "pause_after": 0.65
  },
  {
   "take": 10,
   "beat": "liar",
   "text": "But a scanner can't see holes.",
   "t0": 35.4695,
   "t1": 37.1695,
   "pause_after": 0.25
  },
  {
   "take": 11,
   "beat": "liar",
   "text": "To a scanner, a tear looks like a wrong number.",
   "t0": 37.5785,
   "t1": 40.2535,
   "pause_after": 0.4
  },
  {
   "take": 12,
   "beat": "liar",
   "text": "So which dot is lying? The one that's off the line.",
   "t0": 40.8426,
   "t1": 43.6376,
   "pause_after": 0.4
  },
  {
   "take": 13,
   "beat": "liar",
   "text": "Every liar costs two extra dots: one finds it, one fixes it.",
   "t0": 44.1871,
   "t1": 48.387,
   "pause_after": 0.65
  },
  {
   "take": 14,
   "beat": "bytes",
   "text": "A QR code does the same trick, with bytes.",
   "t0": 49.1947,
   "t1": 51.6698,
   "pause_after": 0.3
  },
  {
   "take": 15,
   "beat": "bytes",
   "text": "This one has twenty-six bytes. Nine are your message. Seventeen are extra points.",
   "t0": 52.1137,
   "t1": 57.1037,
   "pause_after": 0.4
  },
  {
   "take": 16,
   "beat": "bytes",
   "text": "At two per liar, it can fix any eight. About thirty percent.",
   "t0": 57.6405,
   "t1": 61.2155,
   "pause_after": 0.45
  },
  {
   "take": 17,
   "beat": "bytes",
   "text": "That's why a logo can sit in the middle. It's damage, on purpose.",
   "t0": 61.8062,
   "t1": 65.6312,
   "pause_after": 0.65
  },
  {
   "take": 18,
   "beat": "fineprint",
   "text": "The catch: that's thirty percent of the bytes, not of the paper.",
   "t0": 66.4322,
   "t1": 69.8072,
   "pause_after": 0.35
  },
  {
   "take": 19,
   "beat": "fineprint",
   "text": "These three corner squares aren't protected at all. They're how the scanner finds the code.",
   "t0": 70.3053,
   "t1": 75.0553,
   "pause_after": 0.3
  },
  {
   "take": 20,
   "beat": "fineprint",
   "text": "Tear into one, and this code won't scan.",
   "t0": 75.5161,
   "t1": 77.8661,
   "pause_after": 0.65
  },
  {
   "take": 21,
   "beat": "payoff",
   "text": "That first tear? It took six of the nine message bytes.",
   "t0": 78.6618,
   "t1": 81.8868,
   "pause_after": 0.3
  },
  {
   "take": 22,
   "beat": "payoff",
   "text": "The extra points rebuilt every one.",
   "t0": 82.3275,
   "t1": 84.5275,
   "pause_after": 0.45
  },
  {
   "take": 23,
   "beat": "payoff",
   "text": "A torn QR code isn't lucky. It was built expecting to be torn.",
   "t0": 85.1404,
   "t1": 89.3654,
   "pause_after": 0.6
  }
 ]

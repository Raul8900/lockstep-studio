{
  "name": "riso-sticker",
  "about": "Risograph print on cream stock: black ink plus spot inks (blue, sunflower, fluorescent pink), a heavy grotesque, hard misregistered offset shadows and a halftone field. Printed objects, codes, labels and 'how this everyday thing works'.",
  "mode": "light",
  "palette": {
    "bg": ["#F4EEE2", "#F1EADC", "#EBE2CF"],
    "ink": "#1B1A1F",
    "subject": "#2A55B5",
    "accent": "#D6338A",
    "data": "#C26A00",
    "alert": "#C92A1E",
    "good": "#2B8742",
    "panel": "#FFFDF8"
  },
  "fonts": { "display": "Archivo Black", "body": "Archivo", "mono": "IBM Plex Mono" },
  "backdrop": { "type": "halftone", "spacing": 36, "color": "subject", "strength": 0.32 },
  "post": { "vignette": 0.16, "scrim": 0.72 },
  "captions": { "highlight": "box", "font": "Archivo", "weight": 800, "size": 76, "strokeW": 12, "boxRadius": 3 },
  "hud": { "type": "line" },
  "shape": { "radius": 5, "stroke": 3, "strokeAlpha": 1, "panelAlpha": 1, "shadow": { "dx": 9, "dy": 9, "color": "subject" } },
  "transition": { "duration": 0.55, "default": "slideLeft" }
}
